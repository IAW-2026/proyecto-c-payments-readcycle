# --- DATABASE CONFIGURATION ---
# Connection URL for Supabase (via connection pooler, e.g., transaction pooler at port 6543)
DATABASE_URL="postgresql://username:password@pooler-host:6543/database?pgbouncer=true"

# Direct connection URL to the database. Used for running Prisma migrations (direct port, e.g., 5432)
DIRECT_URL="postgresql://username:password@db-host:5432/database"


# --- CLERK CONFIGURATION (Authentication) ---
# Clerk Publishable Key (safe to expose publicly)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key_here

# Clerk Secret Key (keep this private!)
CLERK_SECRET_KEY=sk_test_placeholder_key_here


# --- MERCADO PAGO CONFIGURATION (Payments) ---
# Mercado Pago Access Token for the backend (private credentials)
MP_ACCESS_TOKEN=APP_USR-placeholder_token_here

# Mercado Pago Public Key for the frontend (public credentials)
NEXT_PUBLIC_MP_PUBLIC_KEY=APP_USR-placeholder_key_here

# Mercado Pago Webhook Secret / Hook Secret for signature validation
MP_HOOK_SECRET=placeholder_hook_secret_here
MP_WEBHOOK_SECRET=placeholder_webhook_secret_here

# --- API KEYS FOR BACKEND SERVICE INTEGRATIONS ---
CHECKOUT_API_KEY=checkout_key_test_123
TRANSACTIONS_API_KEY=transactions_key_test_123
DISPUTES_API_KEY=disputes_key_test_123

# --- API KEYS FOR CONNECTION WITH SELLER ---
SELLER_API_KEY=webhook_token_123
SELLER_WEBHOOK=link_seller
